# Ripple real-solution configuration — TEMPLATE.
#
# Copy to dev.env and fill every value. dev.env is gitignored (never committed).
#   cp dev.env.example dev.env    # then edit dev.env
#   source dev.env                # load into your shell before running scripts
#
# NON-SECRET values only. Client secrets / API tokens go in your shell ONLY
# (export in the terminal), never in this file or dev.env.

# ---- AWS / AgentCore ----
export AWS_REGION=<aws-region>                         # e.g. us-west-2
export BEDROCK_MODEL_ID=<bedrock-model-id>             # e.g. us.anthropic.claude-opus-4-8

# ---- Auth0 (Okta) — front-door user identity ----
export AUTH0_DOMAIN=<tenant>.us.auth0.com
export AUTH0_AUDIENCE=<api-identifier>                 # the Auth0 API audience
export AUTH0_CLI_CLIENT_ID=<native-app-client-id>      # public client, no secret
export AUTH0_SCOPE="openid profile email offline_access"

# ---- Data source: GitHub (per-user OAuth, you own the app) ----
export GITHUB_CREDENTIAL_PROVIDER=<agentcore-provider-name>   # e.g. ripple-github
export GITHUB_CLIENT_ID=<github-oauth-app-client-id>
export GITHUB_SCOPES="repo read:org"
# GITHUB_CLIENT_SECRET -> never set here. The deploy path does NOT read it: the
# credential provider is a CloudFormation resource (infra/02-runtime.yaml) fed by
# GITHUB_CLIENT_SECRET_ARN below. Only the standalone scripts/create_github_provider.py
# reads GITHUB_CLIENT_SECRET, and you do not need that script.

# ---- AgentCore Memory (per-user short-term; actorId = Auth0 sub) ----
export AGENTCORE_MEMORY_ID=<memory-id>                 # e.g. RippleKnowledgeMemory-xxxx

# ---- Deployed runtime (fill from CFN outputs after scripts/deploy.py) ----
# deploy.py prints these three as ready-to-paste export lines.
export RIPPLE_RUNTIME_ARN=<runtime-arn>                # arn:aws:bedrock-agentcore:...:runtime/ripple-xxxx
export RIPPLE_RUNTIME_QUALIFIER=live                   # the EndpointName output ('live'), not DEFAULT

# ---- GitHub client secret in Secrets Manager (PREFERRED) ----
# One-time setup: infra/README.md § "The GitHub client secret". Passing the ARN
# keeps the secret out of the template and out of CloudFormation history — unset
# it only to fall back to ClientSecretSource=MANAGED.
export GITHUB_CLIENT_SECRET_ARN=<secret-arn>           # arn:aws:secretsmanager:...:secret:ripple/github-oauth-xxxxxx

# ---- CloudFormation stack names (optional; defaults shown) ----
# export FOUNDATION_STACK=ripple-foundation
# export RUNTIME_STACK=ripple-runtime
# export AGENTCORE_AGENT_NAME=ripple      # must match the AgentName stack parameter

# NOTE: AGENTCORE_EXECUTION_ROLE_ARN and AGENTCORE_CODEBUILD_ROLE_ARN are no
# longer needed. The starter toolkit required pre-existing hand-made roles; the
# CFN templates DECLARE both roles (project-scoped and cost-tagged), so there is
# nothing to point at. apply_tags.py reads the CodeBuild role from the stack.

# ---- Cost allocation tag ----
# Defined as constants in scripts/tags.py (project_name=ripple_slack_assistant) so
# the key/value can never drift per-shell — a cost allocation tag only aggregates
# when it is byte-identical on every resource. Uncomment ONLY to run a second
# stack from this code under a different tag.
# export PROJECT_TAG_KEY=project_name
# export PROJECT_TAG_VALUE=ripple_slack_assistant
