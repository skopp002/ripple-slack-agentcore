# Local config with real values (template lives in dev.env.example)
dev.env

# Cached user tokens
client/.token.json

# Virtual environments
.venv/
.venv-deploy/

# Python cache
__pycache__/
*.py[cod]

# Starter-toolkit state. Still ignored: it is machine-local (absolute paths,
# account id, a runtime id from one deploy) and the CloudFormation path does not
# read it. Safe to delete once the toolkit is uninstalled.
.bedrock_agentcore.yaml
.bedrock_agentcore/

# NOTE: Dockerfile and .dockerignore were listed here as "toolkit-generated" and
# are now COMMITTED SOURCE. scripts/cfn_build.py requires the Dockerfile in the
# build zip, so ignoring it meant a fresh clone could not build at all. The
# toolkit is being retired; this repo owns its container definition.
